<?xml version='1.0' encoding='utf-8'?>
<launch>
    <arg name="controller_config_file" default="$(find gazebo_sim_examples)/config/launch/fs150_uav1_nmpc_tracking_px4_multirotor_controller.yaml" />
    <arg name="reference_config_file" default="$(find gazebo_sim_examples)/config/launch/fs150_uav1_nmpc_tracking_multirotor_reference_trajectory.yaml" />
    <arg name="ns" default="uav1" />
    <arg name="vrpn_rigid_body" default="$(arg ns)" />
    <arg name="fs150_id" default="4" />
    <arg name="model_name" default="fs150_$(arg fs150_id)" />
    <arg name="gui" default="true" />
    <arg name="rviz" default="true" />
    <arg name="paused" default="false" />
    <arg name="debug" default="false" />
    <arg name="verbose" default="false" />
    <arg name="interactive" default="false" />
    <arg name="world" default="$(find gazebo_sim_worlds)/worlds/empty/empty.world" />
    <arg name="sdf" default="$(find gazebo_sim_fs150_sitl)/models/fs150/iris.sdf" />
    <arg name="param_file" default="$(find gazebo_sim_fs150_sitl)/config/generated/fs150-sitl.params" />
    <arg name="enable_vrpn_server" default="true" />
    <arg name="takeoff_altitude" default="3.0" />
    <arg name="auto_takeoff_track" default="true" />
    <arg name="estimator_config_file" default="$(find estimator_vrpn_px4_rotor_state)/config/vrpn_px4_rotor_state_estimator_gazebo.yaml" />
    <arg name="hover_thrust_config_file" default="$(find hover_thrust_estimator)/config/hover_thrust_estimator.yaml" />
    <arg name="rviz_config" default="$(find gazebo_sim_examples)/rviz/fs150_uav1_nmpc_tracking.rviz" />
    <include file="$(find gazebo_sim_fs150_sitl)/launch/fs150.launch">
        <arg name="ID" value="$(arg fs150_id)" />
        <arg name="ns" value="$(arg ns)" />
        <arg name="model_name" value="$(arg model_name)" />
        <arg name="world" value="$(arg world)" />
        <arg name="sdf" value="$(arg sdf)" />
        <arg name="param_file" value="$(arg param_file)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="debug" value="$(arg debug)" />
        <arg name="verbose" value="$(arg verbose)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="interactive" value="$(arg interactive)" />
    </include>
    <include file="$(find gazebo_sim_fs150_sitl)/launch/fs150_robot_description.launch">
        <arg name="sdf" value="$(arg sdf)" />
    </include>
    <include if="$(arg enable_vrpn_server)" file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_server.launch">
        <arg name="config_file" value="$(find gazebo_sim_examples)/config/fs150_uav1_vrpn_server.yaml" />
        <arg name="auto_track_known_models" value="false" />
    </include>
    <include if="$(arg enable_vrpn_server)" file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_client.launch">
        <arg name="server" value="127.0.0.1" />
        <arg name="trackers" value="[$(arg vrpn_rigid_body)]" />
        <arg name="frame_id" value="world" />
    </include>
    <node pkg="tf" type="static_transform_publisher" name="world_to_map" args="0 0 0 0 0 0 world map 100" />
    <node pkg="tf" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world odom 100" />
    <node pkg="gazebo_sim_examples" type="pose_to_tf" name="uav1_pose_to_tf" output="screen">
        <rosparam command="load" file="$(find gazebo_sim_examples)/config/launch/fs150_uav1_nmpc_tracking_uav1_pose_to_tf.yaml" subst_value="true" />
    </node>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="fs150_robot_state_publisher" output="screen" />
    <include file="$(find estimator_vrpn_px4_rotor_state)/launch/vrpn_px4_rotor_state_estimator.launch">
        <arg name="ns" value="$(arg ns)" />
        <arg name="config_file" value="$(arg estimator_config_file)" />
    </include>
    <include file="$(find hover_thrust_estimator)/launch/hover_thrust_estimator.launch">
        <arg name="ns" value="$(arg ns)" />
        <arg name="config_file" value="$(arg hover_thrust_config_file)" />
    </include>
    <include file="$(find multirotor_reference_trajectory)/launch/uav_multirotor_reference_trajectory.launch">
        <arg name="ns" value="$(arg ns)" />
        <arg name="config_file" value="$(arg reference_config_file)" />
    </include>
    <include file="$(find px4_multirotor_controller)/launch/uav_nmpc_controller.launch">
        <arg name="ns" value="$(arg ns)" />
        <arg name="config_file" value="$(arg controller_config_file)" />
    </include>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="fs150_nmpc_rviz" args="-d $(arg rviz_config)" output="screen" />
    <node if="$(arg auto_takeoff_track)" pkg="gazebo_sim_examples" type="uav_auto_takeoff_track.py" name="uav_auto_takeoff_track" output="screen" args="--ns $(arg ns) --height $(arg takeoff_altitude)" />
</launch>